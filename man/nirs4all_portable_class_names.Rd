\name{nirs4all_portable_class_names}
\alias{nirs4all_portable_class_names}
\title{List classes in a portable pipeline definition}
\usage{nirs4all_portable_class_names(definition)}
\arguments{\item{definition}{Loaded or nested pipeline definition.}}
\value{Character vector of fully qualified class names.}
\description{Recursively collects class names for inspecting imported JSON/YAML definitions.}
